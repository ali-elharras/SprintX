{
  "name": "university-event-management",
  "version": "1.0.0",
  "description": "University Event Management System - MERN Stack",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/show-credentials.js && concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm install && npm run install-backend && npm run install-frontend",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "mern",
    "university",
    "event-management",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "manual": "^1.0.2",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1"
  }
}

# Frontend Environment Configuration Example
# Copy this file to .env and configure according to your setup

# Backend API URL - Change this to match your backend port
REACT_APP_API_URL=http://localhost:8080/api

# If your backend runs on port 5000 (or any other port), change the line above to:
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_API_URL=http://localhost:3001/api
# etc.
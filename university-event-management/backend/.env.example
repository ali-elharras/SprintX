# Backend Environment Configuration Example
# Copy this file to .env and configure according to your setup

# Database Configuration
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.mongodb.net/your-database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=8080
# Alternative port for compatibility with macOS AirPlay: PORT=5000
NODE_ENV=development

# Backend URL for emails (used in verification links)
# Should match the PORT above
BACKEND_URL=http://localhost:8080
# If using port 5000: BACKEND_URL=http://localhost:5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration
EMAIL_FROM=your-email@example.com
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password